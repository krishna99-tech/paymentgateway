<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PaymentGateway" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Dark mode colors -->
        <item name="colorPrimary">#9FA8DA</item>
        <item name="colorPrimaryVariant">@color/payment_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">#81C784</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Custom status backgrounds -->
        <item name="statusSuccessBg">@color/status_success_bg_dark</item>
        <item name="statusFailedBg">@color/status_failed_bg_dark</item>
        <item name="statusPendingBg">@color/status_pending_bg_dark</item>

        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
