<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Paymentapp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/payment_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/payment_bg</item>
        <item name="colorSurface">@color/payment_surface</item>
        <item name="colorOnSurface">@color/black</item>
    </style>

    <!-- Modern Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#2563EB</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Paymentapp</item>
    </style>

    <style name="Theme.PaymentGateway" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/payment_primary</item>
        <item name="colorPrimaryVariant">@color/payment_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#4CAF50</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Status Colors -->
        <item name="statusSuccessBg">@color/status_success_bg</item>
        <item name="statusFailedBg">@color/status_failed_bg</item>
        <item name="statusPendingBg">@color/status_pending_bg</item>
    </style>

    <attr name="statusSuccessBg" format="color" />
    <attr name="statusFailedBg" format="color" />
    <attr name="statusPendingBg" format="color" />

</resources>
